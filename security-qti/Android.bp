cc_binary {
    name: "android.hardware.security.keymint-service.custom",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.security.keymint-service.custom.rc"],
    vintf_fragments: ["android.hardware.security.keymint-service.custom.xml"],
    srcs: [
        "service.cpp",
        "QseeComWrapper.cpp",
        "Gatekeeper.cpp",
        "KeyMint.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libdl",
        "liblog",
        "libutils",
        "android.hardware.gatekeeper-V1-ndk",
        "android.hardware.security.keymint-V1-ndk",
        "android.hardware.security.secureclock-V1-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "libkeymaster_messages",
        "libkeymaster_portable",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
